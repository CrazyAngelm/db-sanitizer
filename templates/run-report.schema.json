{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/db-sanitizer/run-report.schema.json",
  "title": "DB Sanitizer Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "policy_sha256",
    "source_schema_sha256",
    "llm",
    "tables",
    "groups",
    "checks",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "structured_output",
        "batches",
        "accepted_items",
        "rejected_items",
        "duration_seconds"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "structured_output": {
          "const": true
        },
        "batches": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_items": {
          "type": "integer",
          "minimum": 1
        },
        "rejected_items": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_rows",
          "target_rows",
          "row_count_equal"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_rows": {
            "type": "integer",
            "minimum": 0
          },
          "target_rows": {
            "type": "integer",
            "minimum": 0
          },
          "row_count_equal": {
            "type": "boolean"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entity_type",
          "mapping_count",
          "distinct_source",
          "distinct_target",
          "nulls_source",
          "nulls_target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entity_type": {
            "enum": [
              "person_name",
              "email",
              "phone",
              "address"
            ]
          },
          "mapping_count": {
            "type": "integer",
            "minimum": 1
          },
          "distinct_source": {
            "type": "integer",
            "minimum": 1
          },
          "distinct_target": {
            "type": "integer",
            "minimum": 1
          },
          "nulls_source": {
            "type": "integer",
            "minimum": 0
          },
          "nulls_target": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "severity",
          "status",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "required",
              "advisory"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warn"
            ]
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sanitized_dump",
        "generated_greenmask_config",
        "mapping_registry",
        "markdown_report"
      ],
      "properties": {
        "sanitized_dump": {
          "type": "string"
        },
        "generated_greenmask_config": {
          "type": "string"
        },
        "mapping_registry": {
          "type": "string"
        },
        "markdown_report": {
          "type": "string"
        }
      }
    }
  }
}
