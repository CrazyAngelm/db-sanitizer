# Скопируйте в .env, заполните placeholders и никогда не коммитьте .env.
POSTGRES_USER=sanitizer
POSTGRES_PASSWORD=change-me-for-local-demo
SOURCE_POSTGRES_DB=sanitizer_source
TARGET_POSTGRES_DB=sanitizer_target
SOURCE_DATABASE_URL=postgresql://sanitizer:change-me-for-local-demo@source-db:5432/sanitizer_source
TARGET_DATABASE_URL=postgresql://sanitizer:change-me-for-local-demo@target-db:5432/sanitizer_target
# Сгенерируйте приватный случайный ключ >= 32 байт, например: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SANITIZER_HMAC_KEY=
# Необязательный удалённый provider; нужен только для make demo-openrouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Основной локальный provider. Это имя одновременно использует policy и ollama-pull.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
