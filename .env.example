# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_USER=sanitizer
POSTGRES_PASSWORD=change-me-for-local-demo
SOURCE_POSTGRES_DB=sanitizer_source
TARGET_POSTGRES_DB=sanitizer_target
SOURCE_DATABASE_URL=postgresql://sanitizer:change-me-for-local-demo@source-db:5432/sanitizer_source
TARGET_DATABASE_URL=postgresql://sanitizer:change-me-for-local-demo@target-db:5432/sanitizer_target
SANITIZER_HMAC_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
